# Provider selection
# EMBEDDING_PROVIDER: openai (default) or venice
# VECTOR_STORE_PROVIDER: pgvector (default) or pinecone
EMBEDDING_PROVIDER=openai
VECTOR_STORE_PROVIDER=pgvector

# OpenAI Configuration (required when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_API_VERSION=2023-05-15

# Venice AI Configuration (required when EMBEDDING_PROVIDER=venice)
# Get your API key from https://venice.ai
VENICE_API_KEY=
VENICE_MODEL=text-embedding-bge-m3

# Pinecone Configuration (required when VECTOR_STORE_PROVIDER=pinecone)
# Get your API key from https://www.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=

# Pinecone Namespace (optional)
# Leave empty if not using namespaces
PINECONE_NAMESPACE=

# PostgreSQL + pgvector (required when VECTOR_STORE_PROVIDER=pgvector)
# Example:
# PGVECTOR_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# PGVECTOR_TABLE=semantic_vectors
# PGVECTOR_DIMENSION=1536
PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
PGVECTOR_TABLE=semantic_vectors
PGVECTOR_DIMENSION=1536

# RPC URL (required for indexing service)
# Used for blockchain access during agent indexing
# For Nile proxy in this repo:
RPC_URL=https://nile.trongrid.io/jsonrpc

# For local development, create a .dev.vars file with these values
# Wrangler will automatically load .dev.vars in development mode
